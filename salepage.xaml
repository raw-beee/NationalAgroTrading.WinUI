<Page
    x:Class="NationalAgroTrading.WinUI.Views.Sales.AddSalePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:controls="using:NationalAgroTrading.WinUI.Controls"
    mc:Ignorable="d">

	<Page.Resources>

		<!-- =========================================================
             COMMON STYLES
             ========================================================= -->

		<Style x:Key="SectionBorderStyle"
               TargetType="Border">
			<Setter Property="Background"
                    Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
			<Setter Property="BorderBrush"
                    Value="{ThemeResource CardStrokeColorDefaultBrush}" />
			<Setter Property="BorderThickness"
                    Value="1" />
			<Setter Property="CornerRadius"
                    Value="10" />
			<Setter Property="Padding"
                    Value="20" />
			<Setter Property="Margin"
                    Value="0,0,0,16" />
		</Style>

		<Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">
			<Setter Property="FontSize"
                    Value="18" />
			<Setter Property="FontWeight"
                    Value="SemiBold" />
			<Setter Property="Margin"
                    Value="0,0,0,16" />
		</Style>

		<Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">
			<Setter Property="FontSize"
                    Value="13" />
			<Setter Property="FontWeight"
                    Value="SemiBold" />
			<Setter Property="Opacity"
                    Value="0.8" />
			<Setter Property="Margin"
                    Value="0,0,0,6" />
		</Style>

		<Style x:Key="FieldTextBoxStyle"
               TargetType="TextBox">
			<Setter Property="MinHeight"
                    Value="40" />
			<Setter Property="HorizontalAlignment"
                    Value="Stretch" />
		</Style>

		<Style x:Key="SummaryLabelStyle"
               TargetType="TextBlock">
			<Setter Property="FontSize"
                    Value="14" />
			<Setter Property="Margin"
                    Value="0,5" />
		</Style>

	</Page.Resources>


	<Grid Padding="28">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>


		<!-- =========================================================
             HEADER
             ========================================================= -->

		<Grid Grid.Row="0"
              Margin="0,0,0,22">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel>

				<TextBlock
                    Text="Add Sale"
                    FontSize="30"
                    FontWeight="SemiBold" />

				<TextBlock
                    Text="Create a new sales bill"
                    FontSize="14"
                    Opacity="0.65"
                    Margin="0,4,0,0" />

			</StackPanel>


			<Button
                Grid.Column="1"
                Content="Cancel"
                Click="BackButton_Click"
                Padding="20,10"
                VerticalAlignment="Center" />

		</Grid>


		<!-- =========================================================
             MAIN CONTENT
             ========================================================= -->

		<ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto">

			<StackPanel>


				<!-- =================================================
                     BILL INFORMATION
                     ================================================= -->

				<Border
                    Style="{StaticResource SectionBorderStyle}">

					<StackPanel>

						<TextBlock
                            Text="Bill Information"
                            Style="{StaticResource SectionTitleStyle}" />


						<Grid>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="2*" />
								<ColumnDefinition Width="1*" />
								<ColumnDefinition Width="1*" />
							</Grid.ColumnDefinitions>


							<!-- COMPANY -->

							<StackPanel
                                Grid.Column="0"
                                Margin="0,0,14,0">

								<TextBlock
                                    Text="Company"
                                    Style="{StaticResource FieldLabelStyle}" />

								<AutoSuggestBox
                                    x:Name="CompanyAutoSuggestBox"
                                    PlaceholderText="Search company..."
                                    TextChanged="CompanyAutoSuggestBox_TextChanged"
                                    SuggestionChosen="CompanyAutoSuggestBox_SuggestionChosen"
                                    HorizontalAlignment="Stretch" />

							</StackPanel>


							<!-- BILL NUMBER -->

							<StackPanel
                                Grid.Column="1"
                                Margin="0,0,14,0">

								<TextBlock
                                    Text="Bill Number"
                                    Style="{StaticResource FieldLabelStyle}" />

								<TextBox
                                    x:Name="BillNumberTextBox"
                                    PlaceholderText="Bill number"
                                    Style="{StaticResource FieldTextBoxStyle}" />

							</StackPanel>


							<!-- DISCOUNT -->

							<StackPanel
                                Grid.Column="2">

								<TextBlock
                                    Text="Discount %"
                                    Style="{StaticResource FieldLabelStyle}" />

								<TextBox
                                    x:Name="DiscountTextBox"
                                    PlaceholderText="0"
                                    TextChanged="DiscountTextBox_TextChanged"
                                    Style="{StaticResource FieldTextBoxStyle}" />

							</StackPanel>

						</Grid>


						<!-- DATE -->

						<StackPanel
                            Margin="0,18,0,0">

							<TextBlock
                                Text="Sale Date"
                                Style="{StaticResource FieldLabelStyle}" />

							<controls:NepaliDatePicker
                                x:Name="SaleDatePicker" />

						</StackPanel>

					</StackPanel>

				</Border>


				<!-- =================================================
                     ITEM ENTRY
                     ================================================= -->

				<Border
                    Style="{StaticResource SectionBorderStyle}">

					<StackPanel>

						<TextBlock
                            Text="Add Sale Item"
                            Style="{StaticResource SectionTitleStyle}" />


						<!-- PRODUCT -->

						<Grid Margin="0,0,0,14">

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="3*" />
								<ColumnDefinition Width="1*" />
								<ColumnDefinition Width="1.2*" />
								<ColumnDefinition Width="1*" />
								<ColumnDefinition Width="1*" />
							</Grid.ColumnDefinitions>


							<!-- PRODUCT -->

							<StackPanel
                                Grid.Column="0"
                                Margin="0,0,12,0">

								<TextBlock
                                    Text="Product"
                                    Style="{StaticResource FieldLabelStyle}" />

								<AutoSuggestBox
                                    x:Name="ProductAutoSuggestBox"
                                    PlaceholderText="Search product..."
                                    TextChanged="ProductAutoSuggestBox_TextChanged"
                                    SuggestionChosen="ProductAutoSuggestBox_SuggestionChosen" />

							</StackPanel>


							<!-- QUANTITY -->

							<StackPanel
                                Grid.Column="1"
                                Margin="0,0,12,0">

								<TextBlock
                                    Text="Quantity"
                                    Style="{StaticResource FieldLabelStyle}" />

								<TextBox
                                    x:Name="QuantityTextBox"
                                    PlaceholderText="Qty"
                                    TextChanged="ItemInput_TextChanged"
                                    Style="{StaticResource FieldTextBoxStyle}" />

							</StackPanel>


							<!-- PRICE -->

							<StackPanel
                                Grid.Column="2"
                                Margin="0,0,12,0">

								<TextBlock
                                    Text="Selling Price"
                                    Style="{StaticResource FieldLabelStyle}" />

								<TextBox
                                    x:Name="PriceTextBox"
                                    PlaceholderText="0.00"
                                    TextChanged="ItemInput_TextChanged"
                                    Style="{StaticResource FieldTextBoxStyle}" />

							</StackPanel>


							<!-- STOCK -->

							<StackPanel
                                Grid.Column="3"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">

								<TextBlock
                                    x:Name="StockTextBlock"
                                    Text="Stock: -"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center" />

							</StackPanel>


							<!-- VAT -->

							<StackPanel
                                Grid.Column="4"
                                VerticalAlignment="Center">

								<TextBlock
                                    x:Name="VATStatusTextBlock"
                                    Text="VAT: -"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center" />

							</StackPanel>

						</Grid>


						<!-- PRICE MODE -->

						<Grid Margin="0,0,0,14">

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>


							<TextBlock
                                Text="Price Type"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Margin="0,0,14,0" />


							<Button
                                x:Name="RetailButton"
                                Grid.Column="1"
                                Content="Retail"
                                Click="RetailButton_Click"
                                Padding="20,8"
                                Margin="0,0,8,0" />


							<Button
                                x:Name="WholesaleButton"
                                Grid.Column="2"
                                Content="Wholesale"
                                Click="WholesaleButton_Click"
                                Padding="20,8"
                                HorizontalAlignment="Left" />


							<Button
                                x:Name="AddItemButton"
                                Grid.Column="3"
                                Content="Add Item"
                                Click="AddItemButton_Click"
                                Padding="24,9" />

						</Grid>

					</StackPanel>

				</Border>


				<!-- =================================================
                     ITEMS
                     ================================================= -->

				<Border
                    Style="{StaticResource SectionBorderStyle}">

					<StackPanel>

						<TextBlock
                            Text="Sale Items"
                            Style="{StaticResource SectionTitleStyle}" />


						<Grid>

							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>


							<!-- HEADER -->

							<Border
                                Grid.Row="0"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Padding="10,9">

								<Grid>

									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="3*" />
										<ColumnDefinition Width="0.8*" />
										<ColumnDefinition Width="1.2*" />
										<ColumnDefinition Width="1.2*" />
										<ColumnDefinition Width="1.1*" />
										<ColumnDefinition Width="1.2*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>


									<TextBlock
                                        Text="Product"
                                        Grid.Column="0"
                                        FontWeight="SemiBold" />

									<TextBlock
                                        Text="Qty"
                                        Grid.Column="1"
                                        FontWeight="SemiBold" />

									<TextBlock
                                        Text="Price"
                                        Grid.Column="2"
                                        FontWeight="SemiBold" />

									<TextBlock
                                        Text="Subtotal"
                                        Grid.Column="3"
                                        FontWeight="SemiBold" />

									<TextBlock
                                        Text="Discount"
                                        Grid.Column="4"
                                        FontWeight="SemiBold" />

									<TextBlock
                                        Text="VAT"
                                        Grid.Column="5"
                                        FontWeight="SemiBold" />

									<TextBlock
                                        Text=""
                                        Grid.Column="6" />

								</Grid>

							</Border>


							<!-- ITEMS -->

							<ListView
                                x:Name="SaleItemsListView"
                                Grid.Row="1"
                                SelectionMode="None"
                                IsItemClickEnabled="False"
                                Margin="0,4,0,0">

								<ListView.ItemTemplate>

									<DataTemplate>

										<Border
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="10,10">

											<Grid>

												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="3*" />
													<ColumnDefinition Width="0.8*" />
													<ColumnDefinition Width="1.2*" />
													<ColumnDefinition Width="1.2*" />
													<ColumnDefinition Width="1.1*" />
													<ColumnDefinition Width="1.2*" />
													<ColumnDefinition Width="Auto" />
												</Grid.ColumnDefinitions>


												<TextBlock
                                                    Grid.Column="0"
                                                    Text="{Binding ProductName}"
                                                    VerticalAlignment="Center" />


												<TextBlock
                                                    Grid.Column="1"
                                                    Text="{Binding Quantity}"
                                                    VerticalAlignment="Center" />


												<TextBlock
                                                    Grid.Column="2"
                                                    Text="{Binding Price}"
                                                    VerticalAlignment="Center" />


												<TextBlock
                                                    Grid.Column="3"
                                                    Text="{Binding Subtotal}"
                                                    VerticalAlignment="Center" />


												<TextBlock
                                                    Grid.Column="4"
                                                    Text="{Binding Discount}"
                                                    VerticalAlignment="Center" />


												<TextBlock
                                                    Grid.Column="5"
                                                    Text="{Binding VAT}"
                                                    VerticalAlignment="Center" />


												<Button
                                                    Grid.Column="6"
                                                    Content="Remove"
                                                    Tag="{Binding}"
                                                    Click="RemoveItemButton_Click"
                                                    Padding="12,6" />

											</Grid>

										</Border>

									</DataTemplate>

								</ListView.ItemTemplate>

							</ListView>

						</Grid>

					</StackPanel>

				</Border>


				<!-- =================================================
                     SUMMARY
                     ================================================= -->

				<Border
                    Style="{StaticResource SectionBorderStyle}">

					<Grid>

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>


						<StackPanel
                            Grid.Column="0">

							<TextBlock
                                Text="Bill Summary"
                                Style="{StaticResource SectionTitleStyle}" />

							<TextBlock
                                x:Name="SubtotalTextBlock"
                                Text="Subtotal: Rs. 0.00"
                                Style="{StaticResource SummaryLabelStyle}" />

							<TextBlock
                                x:Name="DiscountAmountTextBlock"
                                Text="Discount: Rs. 0.00"
                                Style="{StaticResource SummaryLabelStyle}" />

							<TextBlock
                                x:Name="VATTextBlock"
                                Text="VAT: Rs. 0.00"
                                Style="{StaticResource SummaryLabelStyle}" />

						</StackPanel>


						<StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

							<TextBlock
                                Text="Grand Total"
                                FontSize="14"
                                HorizontalAlignment="Right"
                                Opacity="0.7" />

							<TextBlock
                                x:Name="GrandTotalTextBlock"
                                Text="Grand Total: Rs. 0.00"
                                FontSize="26"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right"
                                Margin="0,4,0,0" />

						</StackPanel>

					</Grid>

				</Border>


				<!-- =================================================
                     ACTIONS
                     ================================================= -->

				<Grid Margin="0,4,0,20">

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>


					<Button
                        Grid.Column="0"
                        Content="Cancel"
                        Click="BackButton_Click"
                        Padding="24,10"
                        HorizontalAlignment="Left" />


					<Button
                        Grid.Column="1"
                        Content="Save Sale"
                        Click="SaveButton_Click"
                        Padding="30,11"
                        FontWeight="SemiBold" />

				</Grid>

			</StackPanel>

		</ScrollViewer>

	</Grid>

</Page>