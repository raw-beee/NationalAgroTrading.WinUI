<Window
    x:Class="NationalAgroTrading.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="National Agro Trading">

	<Grid Background="{StaticResource AppBackgroundBrush}">

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="248"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- LEFT SIDEBAR -->
		<Border
            Grid.Column="0"
            Background="{StaticResource AppSurfaceBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,0,1,0">

			<Grid>

				<Grid.RowDefinitions>
					<RowDefinition Height="92"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="62"/>
				</Grid.RowDefinitions>

				<!-- BRAND -->
				<Border
                    Grid.Row="0"
                    Background="{StaticResource AppSurfaceBrush}"
                    Padding="24,0">

					<StackPanel
                        VerticalAlignment="Center"
                        Spacing="3">

						<TextBlock
                            Text="NATIONAL AGRO"
                            FontSize="17"
                            FontWeight="Bold"
                            Foreground="{StaticResource AppTextPrimaryBrush}"/>

						<TextBlock
                            Text="TRADING"
                            FontSize="10"
                            FontWeight="SemiBold"
                            CharacterSpacing="140"
                            Foreground="{StaticResource AppTextMutedBrush}"/>

					</StackPanel>

				</Border>

				<!-- NAVIGATION -->
				<ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

					<StackPanel
                        Padding="12,14,12,20"
                        Spacing="3">

						<!-- HOME -->
						<Button
                            x:Name="HomeButton"
                            Click="HomeButton_Click"
                            Style="{StaticResource AppNavigationButtonStyle}">

							<Grid HorizontalAlignment="Stretch">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="34"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE80F;"
                                    FontSize="17"
                                    HorizontalAlignment="Center"/>

								<TextBlock
                                    Grid.Column="1"
                                    Text="Home"
                                    VerticalAlignment="Center"/>
							</Grid>
						</Button>

						<!-- SALES -->
						<Button
                            x:Name="SalesButton"
                            Click="SalesButton_Click"
                            Style="{StaticResource AppNavigationButtonStyle}">

							<Grid HorizontalAlignment="Stretch">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="34"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE8A7;"
                                    FontSize="17"
                                    HorizontalAlignment="Center"/>

								<TextBlock
                                    Grid.Column="1"
                                    Text="Sales"
                                    VerticalAlignment="Center"/>
							</Grid>
						</Button>

						<!-- COUNTER SALES -->
						<Button
                            x:Name="CounterSalesButton"
                            Click="CounterSalesButton_Click"
                            Style="{StaticResource AppNavigationButtonStyle}">

							<Grid HorizontalAlignment="Stretch">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="34"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE7BF;"
                                    FontSize="17"
                                    HorizontalAlignment="Center"/>

								<TextBlock
                                    Grid.Column="1"
                                    Text="Counter Sales"
                                    VerticalAlignment="Center"/>
							</Grid>
						</Button>

						<!-- PURCHASES -->
						<Button
                            x:Name="PurchasesButton"
                            Click="PurchasesButton_Click"
                            Style="{StaticResource AppNavigationButtonStyle}">

							<Grid HorizontalAlignment="Stretch">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="34"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE8B0;"
                                    FontSize="17"
                                    HorizontalAlignment="Center"/>

								<TextBlock
                                    Grid.Column="1"
                                    Text="Purchases"
                                    VerticalAlignment="Center"/>
							</Grid>
						</Button>

						<!-- INVENTORY -->
						<Button
                            x:Name="InventoryButton"
                            Click="InventoryButton_Click"
                            Style="{StaticResource AppNavigationButtonStyle}">

							<Grid HorizontalAlignment="Stretch">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="34"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE7B8;"
                                    FontSize="17"
                                    HorizontalAlignment="Center"/>

								<TextBlock
                                    Grid.Column="1"
                                    Text="Inventory"
                                    VerticalAlignment="Center"/>
							</Grid>
						</Button>

						<!-- ADD PRODUCT -->
						<Button
                            x:Name="AddProductButton"
                            Click="AddProductButton_Click"
                            Style="{StaticResource AppNavigationButtonStyle}">

							<Grid HorizontalAlignment="Stretch">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="34"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE710;"
                                    FontSize="17"
                                    HorizontalAlignment="Center"/>

								<TextBlock
                                    Grid.Column="1"
                                    Text="Product"
                                    VerticalAlignment="Center"/>
							</Grid>
						</Button>

						<!-- LEDGER -->
						<Button
                            x:Name="LedgerButton"
                            Click="LedgerButton_Click"
                            Style="{StaticResource AppNavigationButtonStyle}">

							<Grid HorizontalAlignment="Stretch">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="34"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE9D2;"
                                    FontSize="17"
                                    HorizontalAlignment="Center"/>

								<TextBlock
                                    Grid.Column="1"
                                    Text="Ledger"
                                    VerticalAlignment="Center"/>
							</Grid>
						</Button>

						<!-- COMPANIES -->
						<Button
                            x:Name="CompaniesButton"
                            Click="CompaniesButton_Click"
                            Style="{StaticResource AppNavigationButtonStyle}">

							<Grid HorizontalAlignment="Stretch">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="34"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE716;"
                                    FontSize="17"
                                    HorizontalAlignment="Center"/>

								<TextBlock
                                    Grid.Column="1"
                                    Text="Companies"
                                    VerticalAlignment="Center"/>
							</Grid>
						</Button>

						<!-- PAYMENT -->
						<Button
                            x:Name="PaymentButton"
                            Click="PaymentButton_Click"
                            Style="{StaticResource AppNavigationButtonStyle}">

							<Grid HorizontalAlignment="Stretch">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="34"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE8C7;"
                                    FontSize="17"
                                    HorizontalAlignment="Center"/>

								<TextBlock
                                    Grid.Column="1"
                                    Text="Payment"
                                    VerticalAlignment="Center"/>
							</Grid>
						</Button>

						<!-- EXPENSES -->
						<Button
                            x:Name="ExpensesButton"
                            Click="ExpensesButton_Click"
                            Style="{StaticResource AppNavigationButtonStyle}">

							<Grid HorizontalAlignment="Stretch">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="34"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE7C1;"
                                    FontSize="17"
                                    HorizontalAlignment="Center"/>

								<TextBlock
                                    Grid.Column="1"
                                    Text="Expenses"
                                    VerticalAlignment="Center"/>
							</Grid>
						</Button>

						<!-- CP HISTORY -->
						<Button
                            x:Name="CostPriceHistoryButton"
                            Click="CostPriceHistoryButton_Click"
                            Style="{StaticResource AppNavigationButtonStyle}">

							<Grid HorizontalAlignment="Stretch">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="34"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE9D9;"
                                    FontSize="17"
                                    HorizontalAlignment="Center"/>

								<TextBlock
                                    Grid.Column="1"
                                    Text="CP History"
                                    VerticalAlignment="Center"/>
							</Grid>
						</Button>

						<!-- SP HISTORY -->
						<Button
                            x:Name="SalesPriceHistoryButton"
                            Click="SalesPriceHistoryButton_Click"
                            Style="{StaticResource AppNavigationButtonStyle}">

							<Grid HorizontalAlignment="Stretch">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="34"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE81E;"
                                    FontSize="17"
                                    HorizontalAlignment="Center"/>

								<TextBlock
                                    Grid.Column="1"
                                    Text="SP History"
                                    VerticalAlignment="Center"/>
							</Grid>
						</Button>

					</StackPanel>
				</ScrollViewer>

				<!-- SIDEBAR FOOTER -->
				<Border
                    Grid.Row="2"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,0">

					<StackPanel
                        VerticalAlignment="Center"
                        Spacing="2">

						<TextBlock
                            Text="National Agro Trading"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AppTextSecondaryBrush}"/>

						<TextBlock
                            Text="Accounting &amp; Inventory"
                            FontSize="10"
                            Foreground="{StaticResource AppTextMutedBrush}"/>

					</StackPanel>
				</Border>

			</Grid>
		</Border>

		<!-- MAIN CONTENT -->
		<Grid
            Grid.Column="1"
            Background="{StaticResource AppBackgroundBrush}">

			<Grid.RowDefinitions>
				<RowDefinition Height="76"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- TOP HEADER -->
			<Border
                Grid.Row="0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,0,1">

				<Grid Padding="28,0">

					<TextBlock
                        x:Name="PageTitleTextBlock"
                        Text="Dashboard"
                        Style="{StaticResource AppPageTitleStyle}"
                        VerticalAlignment="Center"/>

				</Grid>
			</Border>

			<!-- PAGE CONTENT -->
			<Frame
                x:Name="MainFrame"
                Grid.Row="1"
                Padding="28,24"/>

		</Grid>

	</Grid>

</Window>