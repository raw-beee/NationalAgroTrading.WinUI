<Page
 x:Class="NationalAgroTrading.WinUI.Views.SalesPriceHistory.SalesPriceHistoryPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d">

	<Grid
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Padding="24">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>


		<!-- ===================================================== -->
		<!-- PAGE HEADER -->
		<!-- ===================================================== -->

		<TextBlock
        Grid.Row="0"
        Text="Sales Price History"
        FontSize="28"
        FontWeight="SemiBold"
        Margin="0,0,0,20"/>


		<!-- ===================================================== -->
		<!-- SEARCH -->
		<!-- ===================================================== -->

		<Grid
        Grid.Row="1"
        Margin="0,0,0,20">

			<AutoSuggestBox x:ConnectionId='5'
            x:Name="txtSearch"
            PlaceholderText="Search product..."
            Width="350"
            HorizontalAlignment="Left"
                                               />

		</Grid>


		<!-- ===================================================== -->
		<!-- HISTORY CONTENT -->
		<!-- ===================================================== -->

		<Grid
        Grid.Row="2">


			<Grid>

				<Grid.RowDefinitions>
					<RowDefinition Height="48"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>


				<!-- TABLE HEADER -->

				<Border
                Grid.Row="0"
                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                CornerRadius="6,6,0,0"
                Padding="12,0">

					<Grid>

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="2.2*"/>
							<ColumnDefinition Width="1.4*"/>
							<ColumnDefinition Width="1.4*"/>
							<ColumnDefinition Width="1.5*"/>
						</Grid.ColumnDefinitions>

						<TextBlock
                        Grid.Column="0"
                        Text="Product Name"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"/>

						<TextBlock
                        Grid.Column="1"
                        Text="Retail Price"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Right"/>

						<TextBlock
                        Grid.Column="2"
                        Text="Wholesale Price"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Right"/>

						<TextBlock
                        Grid.Column="3"
                        Text="Effective Date"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Right"/>

					</Grid>

				</Border>


				<!-- HISTORY LIST -->

				<ListView x:ConnectionId='2'
                x:Name="HistoryListView"
                Grid.Row="1"
                SelectionMode="None"
                BorderThickness="0">

					<ListView.ItemTemplate>

						<DataTemplate>

							<Border
                            Padding="12,10"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">

								<Grid>

									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="2.2*"/>
										<ColumnDefinition Width="1.4*"/>
										<ColumnDefinition Width="1.4*"/>
										<ColumnDefinition Width="1.5*"/>
									</Grid.ColumnDefinitions>


									<!-- PRODUCT -->

									<TextBlock
                                    Grid.Column="0"
                                    Text="{Binding ProductName}"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"/>


									<!-- RETAIL -->

									<TextBlock
                                    Grid.Column="1"
                                    Text="{Binding RetailPrice}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"/>


									<!-- WHOLESALE -->

									<TextBlock
                                    Grid.Column="2"
                                    Text="{Binding WholesalePrice}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"/>


									<!-- DATE -->

									<TextBlock
                                    Grid.Column="3"
                                    Text="{Binding EffectiveDate}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"/>

								</Grid>

							</Border>

						</DataTemplate>

					</ListView.ItemTemplate>

				</ListView>


				<!-- EMPTY STATE -->

				<Border x:ConnectionId='3'
                x:Name="EmptyStatePanel"
                Grid.Row="1"
                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                CornerRadius="0,0,6,6"
                Visibility="Collapsed">

					<StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">

						<TextBlock
                        Text="No sales price history found."
                        FontSize="18"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"/>

						<TextBlock
                        Text="Price changes will appear here when product selling prices are updated."
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center"/>

					</StackPanel>

				</Border>

			</Grid>

		</Grid>

	</Grid>

</Page>

