<Page
    x:Class="NationalAgroTrading.WinUI.Views.Purchase.AddPurchasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NationalAgroTrading.WinUI.Controls">

	<ScrollViewer>

		<Grid Padding="24">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- HEADER -->

			<Grid
                Grid.Row="0"
                Margin="0,0,0,20">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel>

					<TextBlock
                        Text="Add Purchase"
                        FontSize="30"
                        FontWeight="SemiBold"/>

					<TextBlock
                        Text="Create a new purchase bill"
                        FontSize="14"
                        Opacity="0.65"
                        Margin="0,4,0,0"/>

				</StackPanel>

				<Button x:ConnectionId='19'
                    Grid.Column="1"
                    Content="Cancel"
                                              
                    Padding="16,8"/>

			</Grid>

			<!-- BILL INFORMATION -->

			<Border
                Grid.Row="1"
                Padding="16"
                Margin="0,0,0,16"
                BorderThickness="1"
                CornerRadius="8">

				<Grid>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*"/>
						<ColumnDefinition Width="1.2*"/>
						<ColumnDefinition Width="1.2*"/>
						<ColumnDefinition Width="1.3*"/>
					</Grid.ColumnDefinitions>

					<AutoSuggestBox x:ConnectionId='15'
                        x:Name="CompanyAutoSuggestBox"
                        Header="Company"
                        PlaceholderText="Select company"
                                                                       />

					<TextBox x:ConnectionId='16'
                        x:Name="BillNumberTextBox"
                        Grid.Column="1"
                        Header="Bill Number"
                        PlaceholderText="Bill number"
                        Margin="12,0,0,0"/>

					<TextBox x:ConnectionId='17'
                        x:Name="DiscountTextBox"
                        Grid.Column="2"
                        Header="Discount %"
                        Text="0"
                                                                 
                        Margin="12,0,0,0"/>

					<controls:NepaliDatePicker x:ConnectionId='18'
                        x:Name="PurchaseDatePicker"
                        Grid.Column="3"
                        Margin="12,0,0,0"/>

				</Grid>

			</Border>

			<!-- ITEMS -->

			<Grid Grid.Row="2">

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<!-- ITEM ENTRY -->

				<Border
                    Grid.Row="0"
                    Padding="16"
                    Margin="0,0,0,16"
                    BorderThickness="1"
                    CornerRadius="8">

					<Grid>

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="2*"/>
							<ColumnDefinition Width="0.9*"/>
							<ColumnDefinition Width="1.2*"/>
							<ColumnDefinition Width="1*"/>
							<ColumnDefinition Width="1*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<AutoSuggestBox x:ConnectionId='9'
                            x:Name="ProductAutoSuggestBox"
                            Header="Product"
                            PlaceholderText="Select product"
                                                                           
                                                                                     />

						<TextBox x:ConnectionId='10'
                            x:Name="QuantityTextBox"
                            Grid.Column="1"
                            Header="Quantity"
                            PlaceholderText="0"
                                                               
                            Margin="12,0,0,0"/>

						<TextBox x:ConnectionId='11'
                            x:Name="CostPriceTextBox"
                            Grid.Column="2"
                            Header="Cost Price"
                            PlaceholderText="0.00"
                                                               
                            Margin="12,0,0,0"/>

						<TextBlock x:ConnectionId='12'
                            x:Name="ItemSubtotalTextBlock"
                            Grid.Column="3"
                            Text="Subtotal: 0.00"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,8"/>

						<TextBlock x:ConnectionId='13'
                            x:Name="ItemVATTextBlock"
                            Grid.Column="4"
                            Text="VAT: 0.00"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,8"/>

						<Button x:ConnectionId='14'
                            Grid.Column="5"
                            Content="Add Item"
                                                       
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,0"
                            Padding="18,8"/>

					</Grid>

				</Border>

				<!-- ITEM LIST -->

				<Border
                    Grid.Row="1"
                    BorderThickness="1"
                    CornerRadius="8">

					<ListView x:ConnectionId='7'
                        x:Name="PurchaseItemsListView">

						<ListView.Header>

							<Grid Padding="12">

								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="2*"/>
									<ColumnDefinition Width="0.7*"/>
									<ColumnDefinition Width="1*"/>
									<ColumnDefinition Width="1*"/>
									<ColumnDefinition Width="1*"/>
									<ColumnDefinition Width="1.1*"/>
								</Grid.ColumnDefinitions>

								<TextBlock
                                    Text="Product"
                                    FontWeight="SemiBold"/>

								<TextBlock
                                    Grid.Column="1"
                                    Text="Qty"
                                    FontWeight="SemiBold"/>

								<TextBlock
                                    Grid.Column="2"
                                    Text="Cost"
                                    FontWeight="SemiBold"/>

								<TextBlock
                                    Grid.Column="3"
                                    Text="Subtotal"
                                    FontWeight="SemiBold"/>

								<TextBlock
                                    Grid.Column="4"
                                    Text="VAT"
                                    FontWeight="SemiBold"/>

								<TextBlock
                                    Grid.Column="5"
                                    Text="Total"
                                    FontWeight="SemiBold"/>

							</Grid>

						</ListView.Header>

						<ListView.ItemTemplate>

							<DataTemplate>

								<Grid Padding="12">

									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="2*"/>
										<ColumnDefinition Width="0.7*"/>
										<ColumnDefinition Width="1*"/>
										<ColumnDefinition Width="1*"/>
										<ColumnDefinition Width="1*"/>
										<ColumnDefinition Width="1.1*"/>
									</Grid.ColumnDefinitions>

									<TextBlock
                                        Text="{Binding ProductName}"/>

									<TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Quantity}"/>

									<TextBlock
                                        Grid.Column="2"
                                        Text="{Binding CostPrice}"/>

									<TextBlock
                                        Grid.Column="3"
                                        Text="{Binding Subtotal}"/>

									<TextBlock
                                        Grid.Column="4"
                                        Text="{Binding VAT}"/>

									<TextBlock
                                        Grid.Column="5"
                                        Text="{Binding TotalWithVAT}"
                                        FontWeight="SemiBold"/>

								</Grid>

							</DataTemplate>

						</ListView.ItemTemplate>

					</ListView>

				</Border>

			</Grid>

			<!-- SUMMARY -->

			<Grid
                Grid.Row="3"
                Margin="0,16,0,0">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

					<TextBlock x:ConnectionId='4'
                        x:Name="SubtotalTextBlock"
                        Text="Subtotal: Rs. 0.00"
                        Margin="0,0,20,0"/>

					<TextBlock x:ConnectionId='5'
                        x:Name="DiscountAmountTextBlock"
                        Text="Discount: Rs. 0.00"
                        Margin="0,0,20,0"/>

					<TextBlock x:ConnectionId='6'
                        x:Name="VATTotalTextBlock"
                        Text="VAT: Rs. 0.00"/>

				</StackPanel>

				<TextBlock x:ConnectionId='2'
                    x:Name="GrandTotalTextBlock"
                    Grid.Column="1"
                    Text="Grand Total: Rs. 0.00"
                    FontSize="20"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Margin="20,0"/>

				<Button x:ConnectionId='3'
                    Grid.Column="2"
                    Content="Save Purchase"
                                                    
                    Padding="20,9"/>

			</Grid>

		</Grid>

	</ScrollViewer>

</Page>

