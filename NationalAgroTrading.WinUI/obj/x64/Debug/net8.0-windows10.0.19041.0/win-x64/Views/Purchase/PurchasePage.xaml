<Page
    x:Class="NationalAgroTrading.WinUI.Views.Purchase.PurchasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid Padding="24">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- HEADER -->

		<Grid Grid.Row="0"
              Margin="0,0,0,20">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<StackPanel>

				<TextBlock
                    Text="Purchase"
                    FontSize="30"
                    FontWeight="SemiBold"/>

				<TextBlock
                    Text="View purchases by company and bill"
                    FontSize="14"
                    Opacity="0.65"
                    Margin="0,4,0,0"/>

			</StackPanel>

			<Button x:ConnectionId='9'
                Grid.Column="1"
                Content="+ Add Purchase"
                                               
                Padding="18,9"/>

		</Grid>

		<!-- SEARCH -->

		<TextBox x:ConnectionId='2'
            x:Name="SearchTextBox"
            Grid.Row="1"
            PlaceholderText="Search company..."
                                                   
            Margin="0,0,0,16"/>

		<!-- CONTENT -->

		<Grid Grid.Row="2">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="300"/>
				<ColumnDefinition Width="16"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- COMPANY LIST -->

			<Border
                Grid.Column="0"
                BorderThickness="1"
                CornerRadius="8">

				<Grid>

					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<TextBlock
                        Grid.Row="0"
                        Text="Companies"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Padding="16"/>

					<ListView x:ConnectionId='7'
                        x:Name="CompanyListView"
                        Grid.Row="1"
                                                                           >

						<ListView.ItemTemplate>

							<DataTemplate>

								<Grid Padding="14,12">

									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>

									<TextBlock
                                        Text="{Binding CompanyName}"
                                        FontSize="15"
                                        FontWeight="SemiBold"/>

									<TextBlock
                                        Grid.Row="1"
                                        Text="{Binding Summary}"
                                        FontSize="12"
                                        Opacity="0.6"
                                        Margin="0,4,0,0"/>

								</Grid>

							</DataTemplate>

						</ListView.ItemTemplate>

					</ListView>

				</Grid>

			</Border>

			<!-- BILL LIST -->

			<Border
                Grid.Column="2"
                BorderThickness="1"
                CornerRadius="8">

				<Grid>

					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<Grid
                        Grid.Row="0"
                        Padding="16">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<TextBlock x:ConnectionId='5'
                            x:Name="SelectedCompanyTextBlock"
                            Text="Select a company"
                            FontSize="20"
                            FontWeight="SemiBold"/>

						<TextBlock x:ConnectionId='6'
                            x:Name="BillCountTextBlock"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Opacity="0.65"/>

					</Grid>

					<ListView x:ConnectionId='3'
                        x:Name="BillListView"
                        Grid.Row="1"
                                                                >

						<ListView.Header>

							<Grid Padding="14">

								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="1.3*"/>
									<ColumnDefinition Width="1.3*"/>
									<ColumnDefinition Width="0.7*"/>
									<ColumnDefinition Width="1*"/>
									<ColumnDefinition Width="1.3*"/>
								</Grid.ColumnDefinitions>

								<TextBlock
                                    Text="Date"
                                    FontWeight="SemiBold"/>

								<TextBlock
                                    Grid.Column="1"
                                    Text="Bill Number"
                                    FontWeight="SemiBold"/>

								<TextBlock
                                    Grid.Column="2"
                                    Text="Items"
                                    FontWeight="SemiBold"/>

								<TextBlock
                                    Grid.Column="3"
                                    Text="VAT"
                                    FontWeight="SemiBold"/>

								<TextBlock
                                    Grid.Column="4"
                                    Text="Amount"
                                    FontWeight="SemiBold"/>

							</Grid>

						</ListView.Header>

						<ListView.ItemTemplate>

							<DataTemplate>

								<Grid Padding="14">

									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="1.3*"/>
										<ColumnDefinition Width="1.3*"/>
										<ColumnDefinition Width="0.7*"/>
										<ColumnDefinition Width="1*"/>
										<ColumnDefinition Width="1.3*"/>
									</Grid.ColumnDefinitions>

									<TextBlock
                                        Text="{Binding NepaliDate}"/>

									<TextBlock
                                        Grid.Column="1"
                                        Text="{Binding BillNumber}"/>

									<TextBlock
                                        Grid.Column="2"
                                        Text="{Binding ItemCount}"/>

									<TextBlock
                                        Grid.Column="3"
                                        Text="{Binding VAT}"/>

									<TextBlock
                                        Grid.Column="4"
                                        Text="{Binding AmountText}"
                                        FontWeight="SemiBold"/>

								</Grid>

							</DataTemplate>

						</ListView.ItemTemplate>

					</ListView>

				</Grid>

			</Border>

		</Grid>

	</Grid>

</Page>

