<Page
 x:Class="NationalAgroTrading.WinUI.Views.Expenses.ExpensesPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:controls="using:NationalAgroTrading.WinUI.Controls"
 mc:Ignorable="d"
 Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">


	<ScrollViewer
    HorizontalScrollBarVisibility="Disabled"
    VerticalScrollBarVisibility="Auto">

		<Grid Padding="24">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>


			<!-- ===================================================== -->
			<!-- HEADER -->
			<!-- ===================================================== -->

			<Grid Grid.Row="0" Margin="0,0,0,20">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="320"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0">

					<TextBlock
                    Text="Expenses"
                    FontSize="28"
                    FontWeight="SemiBold"/>

					<TextBlock
                    Text="Record and manage business expenses"
                    FontSize="14"
                    Opacity="0.65"
                    Margin="0,4,0,0"/>

				</StackPanel>

				<TextBox x:ConnectionId='25'
                x:Name="txtSearch"
                Grid.Column="1"
                PlaceholderText="Search description or category..."
                                                   
                VerticalAlignment="Center"
                Height="42"/>

			</Grid>


			<!-- ===================================================== -->
			<!-- EXPENSE ENTRY -->
			<!-- ===================================================== -->

			<Border
            Grid.Row="1"
            Padding="20"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Margin="0,0,0,16">

				<Grid>

					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<TextBlock x:ConnectionId='18'
                    x:Name="txtEntryTitle"
                    Text="Add Expense"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Margin="0,0,0,16"/>

					<Grid Grid.Row="1">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="2*"/>
							<ColumnDefinition Width="1.2*"/>
							<ColumnDefinition Width="2*"/>
							<ColumnDefinition Width="2*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>


						<!-- Category -->

						<StackPanel
                        Grid.Column="0"
                        Margin="0,0,12,0">

							<TextBlock
                            Text="Category"
                            FontSize="13"
                            Margin="0,0,0,5"/>

							<ComboBox x:ConnectionId='24'
                            x:Name="cmbCategory"
                            DisplayMemberPath="DisplayName"
                            SelectedValuePath="CategoryID"
                            IsEditable="True"
                            Height="40"/>

						</StackPanel>


						<!-- Amount -->

						<StackPanel
                        Grid.Column="1"
                        Margin="0,0,12,0">

							<TextBlock
                            Text="Amount"
                            FontSize="13"
                            Margin="0,0,0,5"/>

							<TextBox x:ConnectionId='23'
                            x:Name="txtAmount"
                            PlaceholderText="Amount"
                            Height="40"/>

						</StackPanel>


						<!-- Date -->

						<StackPanel
                        Grid.Column="2"
                        Margin="0,0,12,0">

							<TextBlock
                            Text="Expense Date"
                            FontSize="13"
                            Margin="0,0,0,5"/>

							<controls:NepaliDatePicker x:ConnectionId='22'
                            x:Name="dtExpenseDate"
                            Height="46"/>

						</StackPanel>


						<!-- Description -->

						<StackPanel
                        Grid.Column="3"
                        Margin="0,0,12,0">

							<TextBlock
                            Text="Description"
                            FontSize="13"
                            Margin="0,0,0,5"/>

							<TextBox x:ConnectionId='21'
                            x:Name="txtDescription"
                            PlaceholderText="Description"
                            Height="40"/>

						</StackPanel>


						<!-- Add / Update -->

						<StackPanel
                        Grid.Column="4"
                        VerticalAlignment="Bottom">

							<Button x:ConnectionId='19'
                            x:Name="btnAdd"
                            Content="Add"
                                                
                            MinWidth="100"
                            Height="40"/>

							<Button x:ConnectionId='20'
                            x:Name="btnCancelEdit"
                            Content="Cancel"
                                                       
                            Visibility="Collapsed"
                            Margin="0,6,0,0"
                            MinWidth="100"
                            Height="36"/>

						</StackPanel>

					</Grid>

				</Grid>

			</Border>


			<!-- ===================================================== -->
			<!-- FILTER / FISCAL YEAR -->
			<!-- ===================================================== -->

			<Grid
            Grid.Row="2"
            Margin="0,0,0,16">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>


				<!-- Type -->

				<StackPanel
                Grid.Column="0"
                Orientation="Horizontal">

					<StackPanel Margin="0,0,12,0">

						<TextBlock
                        Text="Type"
                        FontSize="12"
                        Opacity="0.7"
                        Margin="0,0,0,4"/>

						<ComboBox x:ConnectionId='17'
                        x:Name="cmbType"
                        Width="150"
                        Height="38"
                                                                   >

							<ComboBoxItem Content="All"/>
							<ComboBoxItem Content="Admin"/>
							<ComboBoxItem Content="Home"/>

						</ComboBox>

					</StackPanel>


					<!-- From -->

					<StackPanel Margin="0,0,12,0">

						<CheckBox x:ConnectionId='15'
                        x:Name="chkFrom"
                        Content="From"
                                                        
                                                          />

						<controls:NepaliDatePicker x:ConnectionId='16'
                        x:Name="dtFrom"
                        Height="46"/>

					</StackPanel>


					<!-- To -->

					<StackPanel Margin="0,0,12,0">

						<CheckBox x:ConnectionId='13'
                        x:Name="chkTo"
                        Content="To"
                                                        
                                                          />

						<controls:NepaliDatePicker x:ConnectionId='14'
                        x:Name="dtTo"
                        Height="46"/>

					</StackPanel>


					<Button x:ConnectionId='12'
                    x:Name="btnFilter"
                    Content="Filter"
                                           
                    VerticalAlignment="Bottom"
                    Height="38"
                    MinWidth="90"/>

				</StackPanel>


				<!-- Previous -->

				<Button x:ConnectionId='7'
                x:Name="btnPrevious"
                Grid.Column="1"
                Content="Previous"
                                         
                VerticalAlignment="Bottom"
                Height="38"
                Margin="8,0"/>


				<!-- Fiscal Year -->

				<ComboBox x:ConnectionId='8'
                x:Name="cmbFiscalYear"
                Grid.Column="2"
                Width="150"
                Height="38"
                VerticalAlignment="Bottom"
                                                                 />


				<!-- Next -->

				<Button x:ConnectionId='9'
                x:Name="btnNext"
                Grid.Column="3"
                Content="Next"
                                     
                VerticalAlignment="Bottom"
                Height="38"
                Margin="8,0"/>


				<!-- PDF -->

				<Button x:ConnectionId='10'
                x:Name="btnPDF"
                Grid.Column="4"
                Content="PDF"
                                    
                VerticalAlignment="Bottom"
                Height="38"
                MinWidth="80"
                Margin="8,0"/>


				<!-- Excel -->

				<Button x:ConnectionId='11'
                x:Name="btnExcel"
                Grid.Column="5"
                Content="Excel"
                                      
                VerticalAlignment="Bottom"
                Height="38"
                MinWidth="80"/>

			</Grid>


			<!-- ===================================================== -->
			<!-- DATA VIEW -->
			<!-- ===================================================== -->

			<Border
            Grid.Row="3"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

				<Grid>

					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>


					<!-- Table Header -->

					<Grid
                    Grid.Row="0"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Padding="12,10">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="0"/>
							<ColumnDefinition Width="2*"/>
							<ColumnDefinition Width="1.2*"/>
							<ColumnDefinition Width="1.5*"/>
							<ColumnDefinition Width="2.5*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<TextBlock
                        Grid.Column="1"
                        Text="Category"
                        FontWeight="SemiBold"/>

						<TextBlock
                        Grid.Column="2"
                        Text="Amount"
                        FontWeight="SemiBold"/>

						<TextBlock
                        Grid.Column="3"
                        Text="Nepali Date"
                        FontWeight="SemiBold"/>

						<TextBlock
                        Grid.Column="4"
                        Text="Description"
                        FontWeight="SemiBold"/>

						<TextBlock
                        Grid.Column="5"
                        Text="Actions"
                        FontWeight="SemiBold"/>

					</Grid>


					<!-- Expense List -->

					<ListView x:ConnectionId='2'
                    x:Name="lvExpenses"
                    Grid.Row="1"
                    SelectionMode="Single"
                    IsItemClickEnabled="False"
                    BorderThickness="0">

						<ListView.ItemTemplate>

							<DataTemplate>

								<Grid
                                Padding="12,10">

									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="0"/>
										<ColumnDefinition Width="2*"/>
										<ColumnDefinition Width="1.2*"/>
										<ColumnDefinition Width="1.5*"/>
										<ColumnDefinition Width="2.5*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>

									<TextBlock
                                    Grid.Column="1"
                                    Text="{Binding CategoryName}"
                                    VerticalAlignment="Center"/>

									<TextBlock
                                    Grid.Column="2"
                                    Text="{Binding AmountText}"
                                    VerticalAlignment="Center"/>

									<TextBlock
                                    Grid.Column="3"
                                    Text="{Binding NepaliDate}"
                                    VerticalAlignment="Center"/>

									<TextBlock
                                    Grid.Column="4"
                                    Text="{Binding Description}"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"/>

									<StackPanel
                                    Grid.Column="5"
                                    Orientation="Horizontal">

										<Button x:ConnectionId='5'
                                        Content="Edit"
                                        Tag="{Binding}"
                                                                 
                                        Margin="4,0"/>

										<Button x:ConnectionId='6'
                                        Content="Delete"
                                        Tag="{Binding}"
                                                                   
                                        Margin="4,0"/>

									</StackPanel>

								</Grid>

							</DataTemplate>

						</ListView.ItemTemplate>

					</ListView>


					<!-- Total -->

					<Border
                    Grid.Row="2"
                    Padding="12"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">

						<Grid>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>

							<TextBlock
                            Text="Total Expenses"
                            FontWeight="SemiBold"
                            FontSize="16"/>

							<TextBlock x:ConnectionId='3'
                            x:Name="txtTotal"
                            Grid.Column="1"
                            Text="0.00"
                            FontWeight="Bold"
                            FontSize="16"/>

						</Grid>

					</Border>

				</Grid>

			</Border>

		</Grid>

	</ScrollViewer>

</Page>

