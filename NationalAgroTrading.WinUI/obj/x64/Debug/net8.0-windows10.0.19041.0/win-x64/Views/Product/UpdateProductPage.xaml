<Page
    x:Class="NationalAgroTrading.WinUI.Views.Product.UpdateProductPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid
        MaxWidth="600"
        Padding="32"
        HorizontalAlignment="Center">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock
            Grid.Row="0"
            Text="Update Product"
            FontSize="28"
            FontWeight="SemiBold"
            Margin="0,0,0,24"/>

		<TextBox x:ConnectionId='2'
            x:Name="ProductNameTextBox"
            Grid.Row="1"
            Header="Product Name"
            IsReadOnly="True"
            Margin="0,0,0,12"/>

		<TextBox x:ConnectionId='3'
            x:Name="CostPriceTextBox"
            Grid.Row="2"
            Header="Cost Price"
            Margin="0,0,0,12"/>

		<TextBox x:ConnectionId='4'
            x:Name="RetailPriceTextBox"
            Grid.Row="3"
            Header="Retail Price"
            Margin="0,0,0,12"/>

		<TextBox x:ConnectionId='5'
            x:Name="WholesalePriceTextBox"
            Grid.Row="4"
            Header="Wholesale Price"
            Margin="0,0,0,12"/>

		<StackPanel
            Grid.Row="5"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="8"
            Margin="0,12,0,0">

			<Button x:ConnectionId='6'
                Content="Cancel"
                                          />

			<Button x:ConnectionId='7'
                Content="Save"
                                        />

		</StackPanel>

	</Grid>

</Page>

