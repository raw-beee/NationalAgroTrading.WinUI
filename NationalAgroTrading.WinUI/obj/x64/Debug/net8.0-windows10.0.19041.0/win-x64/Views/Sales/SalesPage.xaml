<Page
    x:Class="NationalAgroTrading.WinUI.Views.Sales.SalesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

	<Grid Padding="24">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>


		<!-- HEADER -->

		<Grid Grid.Row="0"
              Margin="0,0,0,20">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<StackPanel>

				<TextBlock
                    Text="Sales"
                    FontSize="28"
                    FontWeight="SemiBold"/>

				<TextBlock
                    Text="Manage company sales and invoices"
                    Margin="0,4,0,0"
                    Opacity="0.65"/>

			</StackPanel>

			<Button x:ConnectionId='9'
                Grid.Column="2"
                Content="+ Add Sale"
                                           
                Padding="18,10"/>

		</Grid>


		<!-- SEARCH -->

		<Grid Grid.Row="1"
              Margin="0,0,0,16">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBox x:ConnectionId='7'
                x:Name="SearchTextBox"
                PlaceholderText="Search company or bill number..."
                                                       />

			<TextBlock x:ConnectionId='8'
                Grid.Column="1"
                x:Name="SelectedCompanyTextBlock"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"/>

		</Grid>


		<!-- CONTENT -->

		<Grid Grid.Row="2">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="330"/>
				<ColumnDefinition Width="16"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>


			<!-- COMPANIES -->

			<Border
                Grid.Column="0"
                Padding="16"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

				<Grid>

					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<TextBlock
                        Text="Companies"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Margin="0,0,0,12"/>

					<ListView x:ConnectionId='5'
                        Grid.Row="1"
                        x:Name="CompanyListView"
                                                                           
                        SelectionMode="Single">

						<ListView.ItemTemplate>

							<DataTemplate>

								<Grid Padding="10">

									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>

									<TextBlock
                                        Text="{Binding CompanyName}"
                                        FontWeight="SemiBold"/>

									<TextBlock
                                        Grid.Row="1"
                                        Text="{Binding Summary}"
                                        Margin="0,4,0,0"
                                        Opacity="0.65"/>

								</Grid>

							</DataTemplate>

						</ListView.ItemTemplate>

					</ListView>

				</Grid>

			</Border>


			<!-- BILLS -->

			<Border
                Grid.Column="2"
                Padding="16"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

				<Grid>

					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>


					<TextBlock
                        Text="Sales Bills"
                        FontSize="18"
                        FontWeight="SemiBold"/>


					<TextBlock x:ConnectionId='2'
                        Grid.Row="1"
                        x:Name="BillCountTextBlock"
                        Margin="0,4,0,12"
                        Opacity="0.65"/>


					<ListView x:ConnectionId='3'
                        Grid.Row="2"
                        x:Name="BillListView"
                        SelectionMode="Single"
                                                                >

						<ListView.ItemTemplate>

							<DataTemplate>

								<Border
                                    Padding="14"
                                    Margin="0,0,0,8"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    CornerRadius="6">

									<Grid>

										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="1.4*"/>
											<ColumnDefinition Width="1.2*"/>
											<ColumnDefinition Width="1.2*"/>
											<ColumnDefinition Width="1.3*"/>
										</Grid.ColumnDefinitions>

										<StackPanel>

											<TextBlock
                                                Text="{Binding BillNumber}"
                                                FontWeight="SemiBold"/>

											<TextBlock
                                                Text="{Binding NepaliDate}"
                                                Margin="0,4,0,0"
                                                Opacity="0.65"/>

										</StackPanel>


										<TextBlock
                                            Grid.Column="1"
                                            Text="{Binding ItemCount}"
                                            VerticalAlignment="Center"/>


										<StackPanel
                                            Grid.Column="2">

											<TextBlock
                                                Text="{Binding CompanyName}"
                                                VerticalAlignment="Center"/>

											<TextBlock
                                                Text="{Binding SaleDate}"
                                                Margin="0,3,0,0"
                                                Opacity="0.65"/>

										</StackPanel>


										<TextBlock
                                            Grid.Column="3"
                                            Text="{Binding AmountText}"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"/>

									</Grid>

								</Border>

							</DataTemplate>

						</ListView.ItemTemplate>

					</ListView>

				</Grid>

			</Border>

		</Grid>

	</Grid>

</Page>

