<?xml version="1.0" encoding="utf-8"?>

<Application
    x:Class="NationalAgroTrading.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NationalAgroTrading.WinUI">

	<Application.Resources>

		<ResourceDictionary>

			<!-- ================================================= -->
			<!-- WINUI CONTROLS -->
			<!-- ================================================= -->

			<ResourceDictionary.MergedDictionaries>

				<XamlControlsResources
                    xmlns="using:Microsoft.UI.Xaml.Controls" />

			</ResourceDictionary.MergedDictionaries>


			<!-- ================================================= -->
			<!-- GLOBAL COLORS -->
			<!-- ================================================= -->

			<SolidColorBrush
                x:Key="AppBackgroundBrush"
                Color="#111111"/>

			<SolidColorBrush
                x:Key="AppSurfaceBrush"
                Color="#181818"/>

			<SolidColorBrush
                x:Key="AppSurfaceElevatedBrush"
                Color="#202020"/>

			<SolidColorBrush
                x:Key="AppSurfaceHoverBrush"
                Color="#252525"/>

			<SolidColorBrush
                x:Key="AppBorderBrush"
                Color="#2A2A2A"/>


			<!-- ================================================= -->
			<!-- TEXT COLORS -->
			<!-- ================================================= -->

			<SolidColorBrush
                x:Key="AppTextPrimaryBrush"
                Color="#F5F5F5"/>

			<SolidColorBrush
                x:Key="AppTextSecondaryBrush"
                Color="#C2C2C2"/>

			<SolidColorBrush
                x:Key="AppTextMutedBrush"
                Color="#858585"/>


			<!-- ================================================= -->
			<!-- ACCENT COLORS -->
			<!-- ================================================= -->

			<SolidColorBrush
                x:Key="AppAccentBrush"
                Color="#4F8CFF"/>

			<SolidColorBrush
                x:Key="AppAccentHoverBrush"
                Color="#6A9DFF"/>

			<SolidColorBrush
                x:Key="AppAccentPressedBrush"
                Color="#3B78E7"/>


			<!-- ================================================= -->
			<!-- STATUS COLORS -->
			<!-- ================================================= -->

			<SolidColorBrush
                x:Key="AppSuccessBrush"
                Color="#3FB950"/>

			<SolidColorBrush
                x:Key="AppWarningBrush"
                Color="#D29922"/>

			<SolidColorBrush
                x:Key="AppDangerBrush"
                Color="#F85149"/>


			<!-- ================================================= -->
			<!-- COMMON SIZES -->
			<!-- ================================================= -->

			<x:Double
                x:Key="PagePadding">24</x:Double>

			<x:Double
                x:Key="SectionSpacing">20</x:Double>

			<x:Double
                x:Key="ControlSpacing">10</x:Double>

			<x:Double
                x:Key="SmallSpacing">6</x:Double>


			<!-- ================================================= -->
			<!-- COMMON CORNER RADII -->
			<!-- ================================================= -->

			<CornerRadius
                x:Key="AppSmallCornerRadius">6</CornerRadius>

			<CornerRadius
                x:Key="AppCornerRadius">8</CornerRadius>

			<CornerRadius
                x:Key="AppLargeCornerRadius">12</CornerRadius>


			<!-- ================================================= -->
			<!-- NAVIGATION BUTTON -->
			<!-- ================================================= -->

			<Style
                x:Key="AppNavigationButtonStyle"
                TargetType="Button">

				<Setter
                    Property="HorizontalAlignment"
                    Value="Stretch"/>

				<Setter
                    Property="HorizontalContentAlignment"
                    Value="Left"/>

				<Setter
                    Property="VerticalContentAlignment"
                    Value="Center"/>

				<Setter
                    Property="MinHeight"
                    Value="44"/>

				<Setter
                    Property="Padding"
                    Value="14,0"/>

				<Setter
                    Property="Margin"
                    Value="0,2"/>

				<Setter
                    Property="Background"
                    Value="Transparent"/>

				<Setter
                    Property="Foreground"
                    Value="#C2C2C2"/>

				<Setter
                    Property="BorderThickness"
                    Value="0"/>

				<Setter
                    Property="CornerRadius"
                    Value="8"/>

				<Setter
                    Property="FontSize"
                    Value="14"/>

			</Style>


			<!-- ================================================= -->
			<!-- PRIMARY BUTTON -->
			<!-- ================================================= -->

			<Style
                x:Key="AppPrimaryButtonStyle"
                TargetType="Button">

				<Setter
                    Property="MinHeight"
                    Value="40"/>

				<Setter
                    Property="Padding"
                    Value="18,0"/>

				<Setter
                    Property="Background"
                    Value="#4F8CFF"/>

				<Setter
                    Property="Foreground"
                    Value="#FFFFFF"/>

				<Setter
                    Property="BorderThickness"
                    Value="0"/>

				<Setter
                    Property="CornerRadius"
                    Value="8"/>

				<Setter
                    Property="FontSize"
                    Value="14"/>

			</Style>


			<!-- ================================================= -->
			<!-- SECONDARY BUTTON -->
			<!-- ================================================= -->

			<Style
                x:Key="AppSecondaryButtonStyle"
                TargetType="Button">

				<Setter
                    Property="MinHeight"
                    Value="40"/>

				<Setter
                    Property="Padding"
                    Value="18,0"/>

				<Setter
                    Property="Background"
                    Value="#202020"/>

				<Setter
                    Property="Foreground"
                    Value="#E5E5E5"/>

				<Setter
                    Property="BorderBrush"
                    Value="#2A2A2A"/>

				<Setter
                    Property="BorderThickness"
                    Value="1"/>

				<Setter
                    Property="CornerRadius"
                    Value="8"/>

				<Setter
                    Property="FontSize"
                    Value="14"/>

			</Style>


			<!-- ================================================= -->
			<!-- DANGER BUTTON -->
			<!-- ================================================= -->

			<Style
                x:Key="AppDangerButtonStyle"
                TargetType="Button">

				<Setter
                    Property="MinHeight"
                    Value="40"/>

				<Setter
                    Property="Padding"
                    Value="18,0"/>

				<Setter
                    Property="Background"
                    Value="#F85149"/>

				<Setter
                    Property="Foreground"
                    Value="#FFFFFF"/>

				<Setter
                    Property="BorderThickness"
                    Value="0"/>

				<Setter
                    Property="CornerRadius"
                    Value="8"/>

				<Setter
                    Property="FontSize"
                    Value="14"/>

			</Style>


			<!-- ================================================= -->
			<!-- PAGE TITLE -->
			<!-- ================================================= -->

			<Style
                x:Key="AppPageTitleStyle"
                TargetType="TextBlock">

				<Setter
                    Property="FontSize"
                    Value="24"/>

				<Setter
                    Property="FontWeight"
                    Value="SemiBold"/>

				<Setter
                    Property="Foreground"
                    Value="#F5F5F5"/>

			</Style>


			<!-- ================================================= -->
			<!-- SECTION TITLE -->
			<!-- ================================================= -->

			<Style
                x:Key="AppSectionTitleStyle"
                TargetType="TextBlock">

				<Setter
                    Property="FontSize"
                    Value="17"/>

				<Setter
                    Property="FontWeight"
                    Value="SemiBold"/>

				<Setter
                    Property="Foreground"
                    Value="#F5F5F5"/>

			</Style>


			<!-- ================================================= -->
			<!-- BODY TEXT -->
			<!-- ================================================= -->

			<Style
                x:Key="AppBodyTextStyle"
                TargetType="TextBlock">

				<Setter
                    Property="FontSize"
                    Value="14"/>

				<Setter
                    Property="Foreground"
                    Value="#C2C2C2"/>

			</Style>


			<!-- ================================================= -->
			<!-- MUTED TEXT -->
			<!-- ================================================= -->

			<Style
                x:Key="AppMutedTextStyle"
                TargetType="TextBlock">

				<Setter
                    Property="FontSize"
                    Value="12"/>

				<Setter
                    Property="Foreground"
                    Value="#858585"/>

			</Style>


			<!-- ================================================= -->
			<!-- CARD -->
			<!-- ================================================= -->

			<Style
                x:Key="AppCardStyle"
                TargetType="Border">

				<Setter
                    Property="Background"
                    Value="#181818"/>

				<Setter
                    Property="BorderBrush"
                    Value="#2A2A2A"/>

				<Setter
                    Property="BorderThickness"
                    Value="1"/>

				<Setter
                    Property="CornerRadius"
                    Value="12"/>

				<Setter
                    Property="Padding"
                    Value="20"/>

			</Style>

		</ResourceDictionary>

	</Application.Resources>

</Application>
