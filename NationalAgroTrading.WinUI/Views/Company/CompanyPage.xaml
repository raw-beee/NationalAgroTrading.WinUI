<Page
    x:Class="NationalAgroTrading.WinUI.Views.Company.CompanyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

	<Grid Padding="24">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Header -->
		<Grid Grid.Row="0">

			<TextBlock
                Text="Company List"
                FontSize="24"
                FontWeight="SemiBold"
                VerticalAlignment="Center"/>

			<Button
                x:Name="AddCompanyButton"
                Content="Add Company"
                HorizontalAlignment="Right"
                Click="AddCompanyButton_Click"/>

		</Grid>

		<!-- Search -->
		<TextBox
            x:Name="SearchTextBox"
            Grid.Row="1"
            Margin="0,16,0,16"
            PlaceholderText="Search company..."
            TextChanged="SearchTextBox_TextChanged"/>

		<!-- List -->
		<Border
            Grid.Row="2"
            BorderThickness="1"
            CornerRadius="6">

			<ListView
                x:Name="CompanyListView"
                SelectionMode="Single"
                DoubleTapped="CompanyListView_DoubleTapped">

				<ListView.Header>

					<Grid
                        Padding="12,10"
                        ColumnSpacing="12">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="60"/>
							<ColumnDefinition Width="2*"/>
							<ColumnDefinition Width="1.3*"/>
							<ColumnDefinition Width="1.5*"/>
							<ColumnDefinition Width="1.2*"/>
							<ColumnDefinition Width="1.2*"/>
							<ColumnDefinition Width="2*"/>
						</Grid.ColumnDefinitions>

						<TextBlock
                            Grid.Column="0"
                            Text="ID"
                            FontWeight="SemiBold"/>

						<TextBlock
                            Grid.Column="1"
                            Text="Company Name"
                            FontWeight="SemiBold"/>

						<TextBlock
                            Grid.Column="2"
                            Text="VAT/PAN"
                            FontWeight="SemiBold"/>

						<TextBlock
                            Grid.Column="3"
                            Text="Email"
                            FontWeight="SemiBold"/>

						<TextBlock
                            Grid.Column="4"
                            Text="Contact 1"
                            FontWeight="SemiBold"/>

						<TextBlock
                            Grid.Column="5"
                            Text="Contact 2"
                            FontWeight="SemiBold"/>

						<TextBlock
                            Grid.Column="6"
                            Text="Address"
                            FontWeight="SemiBold"/>

					</Grid>

				</ListView.Header>

				<ListView.ItemTemplate>

					<DataTemplate>

						<Grid
                            Padding="12,10"
                            ColumnSpacing="12">

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="60"/>
								<ColumnDefinition Width="2*"/>
								<ColumnDefinition Width="1.3*"/>
								<ColumnDefinition Width="1.5*"/>
								<ColumnDefinition Width="1.2*"/>
								<ColumnDefinition Width="1.2*"/>
								<ColumnDefinition Width="2*"/>
							</Grid.ColumnDefinitions>

							<TextBlock
                                Grid.Column="0"
                                Text="{Binding CompanyID}"/>

							<TextBlock
                                Grid.Column="1"
                                Text="{Binding CompanyName}"
                                TextTrimming="CharacterEllipsis"/>

							<TextBlock
                                Grid.Column="2"
                                Text="{Binding VAT_PAN_Number}"
                                TextTrimming="CharacterEllipsis"/>

							<TextBlock
                                Grid.Column="3"
                                Text="{Binding Email}"
                                TextTrimming="CharacterEllipsis"/>

							<TextBlock
                                Grid.Column="4"
                                Text="{Binding Contact1}"
                                TextTrimming="CharacterEllipsis"/>

							<TextBlock
                                Grid.Column="5"
                                Text="{Binding Contact2}"
                                TextTrimming="CharacterEllipsis"/>

							<TextBlock
                                Grid.Column="6"
                                Text="{Binding Address}"
                                TextTrimming="CharacterEllipsis"/>

						</Grid>

					</DataTemplate>

				</ListView.ItemTemplate>

			</ListView>

		</Border>

	</Grid>

</Page>