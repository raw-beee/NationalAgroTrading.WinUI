<Page
    x:Class="NationalAgroTrading.WinUI.Views.Payment.PaymentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppSurfaceBrush}">

	<Grid Padding="28">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Header -->
		<Grid Grid.Row="0" Margin="0,0,0,22">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<StackPanel>
				<TextBlock
                    Text="Payments"
                    Style="{StaticResource AppPageTitleStyle}"/>

				<TextBlock
                    Text="Manage received and made payments"
                    Style="{StaticResource AppMutedTextStyle}"
                    Margin="0,5,0,0"/>
			</StackPanel>

			<Button
                Grid.Column="1"
                Content="+  Add Payment"
                Style="{StaticResource AppPrimaryButtonStyle}"
                Click="AddPaymentButton_Click"
                Padding="20,10"/>
		</Grid>

		<!-- Search -->
		<Border
            Grid.Row="1"
            Background="{StaticResource AppSurfaceElevatedBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14"
            Margin="0,0,0,18">

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<TextBox
                    x:Name="SearchBox"
                    PlaceholderText="Search company, receipt, payment method or type..."
                    TextChanged="SearchBox_TextChanged"
                    MinHeight="42"/>

				<Button
                    Grid.Column="1"
                    Content="Refresh"
                    Style="{StaticResource AppSecondaryButtonStyle}"
                    Click="RefreshButton_Click"
                    Margin="12,0,0,0"
                    Padding="18,8"/>
			</Grid>
		</Border>

		<!-- Payment table -->
		<Border
            Grid.Row="2"
            Background="{StaticResource AppSurfaceElevatedBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<!-- Table header -->
				<Border
                    Grid.Row="0"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,13">

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="55"/>
							<ColumnDefinition Width="2*"/>
							<ColumnDefinition Width="1.2*"/>
							<ColumnDefinition Width="1.2*"/>
							<ColumnDefinition Width="1.2*"/>
							<ColumnDefinition Width="1.3*"/>
							<ColumnDefinition Width="1.1*"/>
						</Grid.ColumnDefinitions>

						<TextBlock Text="#" FontWeight="SemiBold"/>
						<TextBlock Grid.Column="1" Text="Company" FontWeight="SemiBold"/>
						<TextBlock Grid.Column="2" Text="Receipt" FontWeight="SemiBold"/>
						<TextBlock Grid.Column="3" Text="Amount" FontWeight="SemiBold"/>
						<TextBlock Grid.Column="4" Text="Date" FontWeight="SemiBold"/>
						<TextBlock Grid.Column="5" Text="Method" FontWeight="SemiBold"/>
						<TextBlock Grid.Column="6" Text="Type" FontWeight="SemiBold"/>
					</Grid>
				</Border>

				<ListView
                    x:Name="PaymentsListView"
                    Grid.Row="1"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="PaymentsListView_ItemClick"
                    RightTapped="PaymentsListView_RightTapped">

					<ListView.ItemTemplate>
						<DataTemplate>
							<Grid Padding="16,13">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="55"/>
									<ColumnDefinition Width="2*"/>
									<ColumnDefinition Width="1.2*"/>
									<ColumnDefinition Width="1.2*"/>
									<ColumnDefinition Width="1.2*"/>
									<ColumnDefinition Width="1.3*"/>
									<ColumnDefinition Width="1.1*"/>
								</Grid.ColumnDefinitions>

								<TextBlock
                                    Text="{Binding PaymentID}"
                                    VerticalAlignment="Center"/>

								<TextBlock
                                    Grid.Column="1"
                                    Text="{Binding CompanyName}"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"/>

								<TextBlock
                                    Grid.Column="2"
                                    Text="{Binding Receipt}"
                                    VerticalAlignment="Center"/>

								<TextBlock
                                    Grid.Column="3"
                                    Text="{Binding AmountDisplay}"
                                    VerticalAlignment="Center"/>

								<TextBlock
                                    Grid.Column="4"
                                    Text="{Binding NepaliDate}"
                                    VerticalAlignment="Center"/>

								<TextBlock
                                    Grid.Column="5"
                                    Text="{Binding PaymentMethod}"
                                    VerticalAlignment="Center"/>

								<Border
                                    Grid.Column="6"
                                    HorizontalAlignment="Left"
                                    Padding="10,4"
                                    CornerRadius="5">

									<TextBlock
                                        Text="{Binding PaymentType}"
                                        FontWeight="SemiBold"/>
								</Border>
							</Grid>
						</DataTemplate>
					</ListView.ItemTemplate>
				</ListView>
			</Grid>
		</Border>

		<!-- Empty state -->
		<TextBlock
            x:Name="EmptyText"
            Grid.Row="2"
            Text="No payments found."
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource AppMutedTextStyle}"
            Visibility="Collapsed"/>
	</Grid>
</Page>