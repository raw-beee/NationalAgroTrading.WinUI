<Page
    x:Class="NationalAgroTrading.WinUI.Views.Ledger.OpeningBalancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NationalAgroTrading.WinUI.Controls">

	<Grid
        Background="White"
        Padding="30">

		<ScrollViewer>

			<StackPanel
                MaxWidth="650"
                HorizontalAlignment="Center">

				<!-- Title -->
				<TextBlock
                    Text="Opening Balance"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Margin="0,0,0,8"/>

				<TextBlock
                    Text="Set the opening balance for a company."
                    FontSize="14"
                    Foreground="Gray"
                    Margin="0,0,0,30"/>


				<!-- Company -->
				<TextBlock
                    Text="Company"
                    FontWeight="SemiBold"
                    Margin="0,0,0,6"/>

				<TextBox
                    x:Name="CompanyTextBox"
                    Height="42"
                    PlaceholderText="Enter company name"/>


				<!-- Date -->
				<TextBlock
                    Text="Opening Date"
                    FontWeight="SemiBold"
                    Margin="0,22,0,6"/>

				<controls:NepaliDatePicker
                    x:Name="OpeningDatePicker"
                    HorizontalAlignment="Left"/>


				<!-- Amount -->
				<TextBlock
                    Text="Amount"
                    FontWeight="SemiBold"
                    Margin="0,22,0,6"/>

				<TextBox
                    x:Name="AmountTextBox"
                    Height="42"
                    PlaceholderText="Enter amount"
                    InputScope="Number"/>


				<!-- Type -->
				<TextBlock
                    Text="Balance Type"
                    FontWeight="SemiBold"
                    Margin="0,22,0,6"/>

				<StackPanel
                    Orientation="Horizontal">

					<RadioButton
                        x:Name="DebitRadioButton"
                        Content="Debit"
                        IsChecked="True"
                        Margin="0,0,30,0"/>

					<RadioButton
                        x:Name="CreditRadioButton"
                        Content="Credit"/>

				</StackPanel>


				<!-- Note -->
				<TextBlock
                    Text="Note"
                    FontWeight="SemiBold"
                    Margin="0,22,0,6"/>

				<TextBox
                    x:Name="NoteTextBox"
                    Height="90"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    PlaceholderText="Optional note"/>


				<!-- Buttons -->
				<StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,30,0,0">

					<Button
                        x:Name="CloseButton"
                        Content="Close"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        Click="CloseButton_Click"/>

					<Button
                        x:Name="SaveButton"
                        Content="Save"
                        Width="100"
                        Height="40"
                        Click="SaveButton_Click"/>

				</StackPanel>

			</StackPanel>

		</ScrollViewer>

	</Grid>

</Page>