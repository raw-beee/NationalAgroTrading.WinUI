<Page
    x:Class="NationalAgroTrading.WinUI.Views.Ledger.LedgerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

	<Grid
        Background="Black"
        Padding="24">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>


		<!-- ===================================================== -->
		<!-- HEADER -->
		<!-- ===================================================== -->

		<Grid Grid.Row="0">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<StackPanel>

				<TextBlock
                    Text="Ledger"
                    FontSize="28"
                    FontWeight="SemiBold"/>

				<TextBlock
                    x:Name="LedgerCompanyTextBlock"
                    Margin="0,4,0,0"
                    FontSize="13"
                    Foreground="Gray"/>

			</StackPanel>

			<StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">

				<Button
                    Content="Opening Balance"
                    Click="OpeningBalanceButton_Click"/>

				<Button
                    Content="Excel"
                    Click="ExcelButton_Click"/>

				<Button
                    Content="PDF"
                    Click="PdfButton_Click"/>

				<Button
                    Content="Print"
                    Click="PrintButton_Click"/>

			</StackPanel>

		</Grid>


		<!-- ===================================================== -->
		<!-- FILTERS -->
		<!-- ===================================================== -->

		<Grid
            Grid.Row="1"
            Margin="0,24,0,18">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="300"/>
				<ColumnDefinition Width="220"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>


			<!-- COMPANY -->

			<StackPanel
                Grid.Column="0">

				<TextBlock
                    Text="Company"
                    FontSize="12"
                    Foreground="Gray"
                    Margin="0,0,0,5"/>

				<ComboBox
                    x:Name="CompanyComboBox"
                    Height="40"
                    PlaceholderText="Select company"
                    SelectionChanged="CompanyComboBox_SelectionChanged"/>

			</StackPanel>


			<!-- FISCAL YEAR -->

			<StackPanel
                Grid.Column="1"
                Margin="20,0,0,0">

				<TextBlock
                    Text="Fiscal Year"
                    FontSize="12"
                    Foreground="Gray"
                    Margin="0,0,0,5"/>

				<ComboBox
                    x:Name="FiscalYearComboBox"
                    Height="40"
                    PlaceholderText="Select fiscal year"
                    SelectionChanged="FiscalYearComboBox_SelectionChanged"/>

			</StackPanel>

		</Grid>


		<!-- ===================================================== -->
		<!-- LEDGER -->
		<!-- ===================================================== -->

		<Border
            Grid.Row="2"
            BorderBrush="#E5E5E5"
            BorderThickness="1"
            CornerRadius="6">

			<Grid>

				<Grid.RowDefinitions>
					<RowDefinition Height="44"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>


				<!-- TABLE HEADER -->

				<Grid
                    Grid.Row="0"
                    Padding="12,0"
                    Background="#F7F7F7">

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="140"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="150"/>
						<ColumnDefinition Width="150"/>
						<ColumnDefinition Width="150"/>
					</Grid.ColumnDefinitions>

					<TextBlock
                        Grid.Column="0"
                        Text="Date"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

					<TextBlock
                        Grid.Column="1"
                        Text="Description"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

					<TextBlock
                        Grid.Column="2"
                        Text="Debit"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>

					<TextBlock
                        Grid.Column="3"
                        Text="Credit"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>

					<TextBlock
                        Grid.Column="4"
                        Text="Balance"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>

				</Grid>


				<!-- TABLE -->

				<ListView
                    x:Name="LedgerListView"
                    Grid.Row="1"
                    BorderThickness="0"
                    SelectionMode="None">

					<ListView.ItemTemplate>

						<DataTemplate>

							<Grid
                                Padding="12,10">

								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="140"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="150"/>
									<ColumnDefinition Width="150"/>
									<ColumnDefinition Width="150"/>
								</Grid.ColumnDefinitions>

								<TextBlock
                                    Grid.Column="0"
                                    Text="{Binding Date}"
                                    VerticalAlignment="Center"/>

								<TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Particular}"
                                    VerticalAlignment="Center"
                                    TextWrapping="NoWrap"/>

								<TextBlock
                                    Grid.Column="2"
                                    Text="{Binding DebitText}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"/>

								<TextBlock
                                    Grid.Column="3"
                                    Text="{Binding CreditText}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"/>

								<TextBlock
                                    Grid.Column="4"
                                    Text="{Binding BalanceText}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"/>

							</Grid>

						</DataTemplate>

					</ListView.ItemTemplate>

				</ListView>


				<!-- EMPTY STATE -->

				<StackPanel
                    x:Name="EmptyStatePanel"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Visible">

					<TextBlock
                        Text="Select a company"
                        FontSize="16"
                        HorizontalAlignment="Center"/>

					<TextBlock
                        Text="Choose a company and fiscal year to view the ledger."
                        Margin="0,6,0,0"
                        Foreground="Gray"
                        HorizontalAlignment="Center"/>

				</StackPanel>

			</Grid>

		</Border>

	</Grid>

</Page>