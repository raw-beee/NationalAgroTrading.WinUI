<Page
    x:Class="NationalAgroTrading.WinUI.Views.Sales.UpdateSalePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:NationalAgroTrading.WinUI.Controls"
    mc:Ignorable="d">

	<Page.Resources>

		<!-- =====================================================
             SECTION BORDER
             ===================================================== -->

		<Style
            x:Key="SectionBorderStyle"
            TargetType="Border">

			<Setter
                Property="Background"
                Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />

			<Setter
                Property="BorderBrush"
                Value="{ThemeResource CardStrokeColorDefaultBrush}" />

			<Setter
                Property="BorderThickness"
                Value="1" />

			<Setter
                Property="CornerRadius"
                Value="10" />

			<Setter
                Property="Padding"
                Value="20" />

			<Setter
                Property="Margin"
                Value="0,0,0,16" />

		</Style>


		<!-- =====================================================
             SECTION TITLE
             ===================================================== -->

		<Style
            x:Key="SectionTitleStyle"
            TargetType="TextBlock">

			<Setter
                Property="FontSize"
                Value="18" />

			<Setter
                Property="FontWeight"
                Value="SemiBold" />

			<Setter
                Property="Margin"
                Value="0,0,0,16" />

		</Style>


		<!-- =====================================================
             FIELD LABEL
             ===================================================== -->

		<Style
            x:Key="FieldLabelStyle"
            TargetType="TextBlock">

			<Setter
                Property="FontSize"
                Value="13" />

			<Setter
                Property="FontWeight"
                Value="SemiBold" />

			<Setter
                Property="Opacity"
                Value="0.8" />

			<Setter
                Property="Margin"
                Value="0,0,0,6" />

		</Style>

	</Page.Resources>


	<Grid
        Padding="28">

		<Grid.RowDefinitions>

			<RowDefinition
                Height="Auto" />

			<RowDefinition
                Height="*" />

		</Grid.RowDefinitions>


		<!-- =====================================================
             HEADER
             ===================================================== -->

		<Grid
            Grid.Row="0"
            Margin="0,0,0,22">

			<Grid.ColumnDefinitions>

				<ColumnDefinition
                    Width="*" />

				<ColumnDefinition
                    Width="Auto" />

			</Grid.ColumnDefinitions>


			<StackPanel>

				<TextBlock
                    Text="Update Sale"
                    FontSize="30"
                    FontWeight="SemiBold" />

				<TextBlock
                    Text="Edit an existing sales bill"
                    FontSize="14"
                    Opacity="0.65"
                    Margin="0,4,0,0" />

			</StackPanel>


			<Button
                Grid.Column="1"
                Content="Cancel"
                Click="BackButton_Click"
                Padding="20,10"
                VerticalAlignment="Center" />

		</Grid>


		<!-- =====================================================
             CONTENT
             ===================================================== -->

		<ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto">

			<StackPanel>


				<!-- =================================================
                     BILL INFORMATION
                     ================================================= -->

				<Border
                    Style="{StaticResource SectionBorderStyle}">

					<StackPanel>

						<TextBlock
                            Text="Bill Information"
                            Style="{StaticResource SectionTitleStyle}" />


						<Grid>

							<Grid.ColumnDefinitions>

								<ColumnDefinition
                                    Width="2*" />

								<ColumnDefinition
                                    Width="1*" />

								<ColumnDefinition
                                    Width="1*" />

							</Grid.ColumnDefinitions>


							<!-- BILL -->

							<StackPanel
                                Grid.Column="0"
                                Margin="0,0,14,0">

								<TextBlock
                                    Text="Bill"
                                    Style="{StaticResource FieldLabelStyle}" />

								<TextBlock
                                    x:Name="BillTextBlock"
                                    Text="Bill: -"
                                    FontSize="16"
                                    VerticalAlignment="Center" />

							</StackPanel>


							<!-- COMPANY -->

							<StackPanel
                                Grid.Column="1"
                                Margin="0,0,14,0">

								<TextBlock
                                    Text="Company"
                                    Style="{StaticResource FieldLabelStyle}" />

								<TextBlock
                                    x:Name="CompanyTextBlock"
                                    Text="Company: -"
                                    FontSize="16"
                                    TextTrimming="CharacterEllipsis" />

							</StackPanel>


							<!-- DATE -->

							<StackPanel
                                Grid.Column="2">

								<TextBlock
                                    Text="Sale Date"
                                    Style="{StaticResource FieldLabelStyle}" />

								<!-- READ ONLY -->
								<TextBlock
                                    x:Name="DateTextBlock"
                                    Text="Nepali Date: -"
                                    FontSize="16" />

							</StackPanel>

						</Grid>


						<!-- BILL NUMBER + DISCOUNT -->

						<Grid
                            Margin="0,18,0,0">

							<Grid.ColumnDefinitions>

								<ColumnDefinition
                                    Width="*" />

								<ColumnDefinition
                                    Width="Auto" />

							</Grid.ColumnDefinitions>


							<!-- BILL NUMBER -->

							<StackPanel>

								<TextBlock
                                    Text="Bill Number"
                                    Style="{StaticResource FieldLabelStyle}" />

								<TextBlock
                                    x:Name="BillNumberTextBlock"
                                    Text="-"
                                    FontSize="15" />

							</StackPanel>


							<!-- DISCOUNT -->

							<StackPanel
                                Grid.Column="1"
                                Width="180">

								<TextBlock
                                    Text="Discount %"
                                    Style="{StaticResource FieldLabelStyle}" />

								<TextBox
                                    x:Name="DiscountTextBox"
                                    PlaceholderText="0"
                                    TextChanged="DiscountTextBox_TextChanged" />

							</StackPanel>

						</Grid>

					</StackPanel>

				</Border>


				<!-- =================================================
                     ADD NEW ITEM
                     ================================================= -->

				<Border
                    Style="{StaticResource SectionBorderStyle}">

					<StackPanel>

						<TextBlock
                            Text="Add Item"
                            Style="{StaticResource SectionTitleStyle}" />


						<Grid>

							<Grid.ColumnDefinitions>

								<ColumnDefinition
                                    Width="3*" />

								<ColumnDefinition
                                    Width="1*" />

								<ColumnDefinition
                                    Width="1.2*" />

								<ColumnDefinition
                                    Width="1*" />

								<ColumnDefinition
                                    Width="Auto" />

							</Grid.ColumnDefinitions>


							<!-- PRODUCT -->

							<StackPanel
                                Grid.Column="0"
                                Margin="0,0,12,0">

								<TextBlock
                                    Text="Product"
                                    Style="{StaticResource FieldLabelStyle}" />

								<AutoSuggestBox
                                    x:Name="ProductAutoSuggestBox"
                                    PlaceholderText="Search product..."
                                    TextChanged="ProductAutoSuggestBox_TextChanged"
                                    SuggestionChosen="ProductAutoSuggestBox_SuggestionChosen" />

							</StackPanel>


							<!-- QUANTITY -->

							<StackPanel
                                Grid.Column="1"
                                Margin="0,0,12,0">

								<TextBlock
                                    Text="Quantity"
                                    Style="{StaticResource FieldLabelStyle}" />

								<TextBox
                                    x:Name="QuantityTextBox"
                                    PlaceholderText="Qty"
                                    TextChanged="ItemInput_TextChanged" />

							</StackPanel>


							<!-- PRICE -->

							<StackPanel
                                Grid.Column="2"
                                Margin="0,0,12,0">

								<TextBlock
                                    Text="Selling Price"
                                    Style="{StaticResource FieldLabelStyle}" />

								<TextBox
                                    x:Name="PriceTextBox"
                                    PlaceholderText="0.00"
                                    TextChanged="ItemInput_TextChanged" />

							</StackPanel>


							<!-- STOCK -->

							<StackPanel
                                Grid.Column="3"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">

								<TextBlock
                                    x:Name="StockTextBlock"
                                    Text="Stock: -"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center" />

							</StackPanel>


							<!-- ADD -->

							<Button
                                Grid.Column="4"
                                x:Name="AddItemButton"
                                Content="Add Item"
                                Click="AddItemButton_Click"
                                Padding="22,9"
                                VerticalAlignment="Bottom" />

						</Grid>

					</StackPanel>

				</Border>


				<!-- =================================================
                     SALE ITEMS
                     ================================================= -->

				<Border
                    Style="{StaticResource SectionBorderStyle}">

					<StackPanel>

						<TextBlock
                            Text="Sale Items"
                            Style="{StaticResource SectionTitleStyle}" />


						<ListView
                            x:Name="SaleItemsListView"
                            SelectionMode="None"
                            IsItemClickEnabled="False">

							<!-- =================================================
                                 HEADER
                                 ================================================= -->

							<ListView.Header>

								<Border
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Padding="10,9">

									<Grid>

										<Grid.ColumnDefinitions>

											<ColumnDefinition
                                                Width="2.3*" />

											<ColumnDefinition
                                                Width="0.9*" />

											<ColumnDefinition
                                                Width="1.3*" />

											<ColumnDefinition
                                                Width="1.1*" />

											<ColumnDefinition
                                                Width="1.2*" />

											<ColumnDefinition
                                                Width="1.1*" />

											<ColumnDefinition
                                                Width="1.1*" />

											<ColumnDefinition
                                                Width="Auto" />

										</Grid.ColumnDefinitions>


										<TextBlock
                                            Text="Product"
                                            Grid.Column="0"
                                            FontWeight="SemiBold" />


										<TextBlock
                                            Text="Qty"
                                            Grid.Column="1"
                                            FontWeight="SemiBold" />


										<TextBlock
                                            Text="Price Type"
                                            Grid.Column="2"
                                            FontWeight="SemiBold" />


										<TextBlock
                                            Text="Price"
                                            Grid.Column="3"
                                            FontWeight="SemiBold" />


										<TextBlock
                                            Text="Subtotal"
                                            Grid.Column="4"
                                            FontWeight="SemiBold" />


										<TextBlock
                                            Text="Discount"
                                            Grid.Column="5"
                                            FontWeight="SemiBold" />


										<TextBlock
                                            Text="VAT"
                                            Grid.Column="6"
                                            FontWeight="SemiBold" />

									</Grid>

								</Border>

							</ListView.Header>


							<!-- =================================================
                                 ITEM ROW
                                 ================================================= -->

							<ListView.ItemTemplate>

								<DataTemplate>

									<Border
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="10,10">

										<Grid>

											<Grid.ColumnDefinitions>

												<ColumnDefinition
                                                    Width="2.3*" />

												<ColumnDefinition
                                                    Width="0.9*" />

												<ColumnDefinition
                                                    Width="1.3*" />

												<ColumnDefinition
                                                    Width="1.1*" />

												<ColumnDefinition
                                                    Width="1.2*" />

												<ColumnDefinition
                                                    Width="1.1*" />

												<ColumnDefinition
                                                    Width="1.1*" />

												<ColumnDefinition
                                                    Width="Auto" />

											</Grid.ColumnDefinitions>


											<!-- PRODUCT -->

											<TextBlock
                                                Grid.Column="0"
                                                Text="{Binding ProductName}"
                                                VerticalAlignment="Center"
                                                TextTrimming="CharacterEllipsis" />


											<!-- QUANTITY -->

											<TextBox
                                                Grid.Column="1"
                                                Width="80"
                                                Text="{Binding Quantity, Mode=TwoWay}"
                                                Tag="{Binding}"
                                                TextChanged="SaleItemQuantity_TextChanged"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center" />


											<!-- PRICE TYPE -->

											<ComboBox
                                                Grid.Column="2"
                                                Width="115"
                                                Tag="{Binding}"
                                                SelectedValue="{Binding PriceType, Mode=TwoWay}"
                                                SelectedValuePath="Tag"
                                                SelectionChanged="SaleItemPriceType_SelectionChanged"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">

												<ComboBoxItem
                                                    Content="Retail"
                                                    Tag="Retail" />

												<ComboBoxItem
                                                    Content="Wholesale"
                                                    Tag="Wholesale" />

											</ComboBox>


											<!-- PRICE -->

											<TextBlock
                                                Grid.Column="3"
                                                Text="{Binding Price}"
                                                VerticalAlignment="Center" />


											<!-- SUBTOTAL -->

											<TextBlock
                                                Grid.Column="4"
                                                Text="{Binding Subtotal}"
                                                VerticalAlignment="Center" />


											<!-- DISCOUNT -->

											<TextBlock
                                                Grid.Column="5"
                                                Text="{Binding Discount}"
                                                VerticalAlignment="Center" />


											<!-- VAT -->

											<TextBlock
                                                Grid.Column="6"
                                                Text="{Binding VAT}"
                                                VerticalAlignment="Center" />


											<!-- REMOVE -->

											<Button
                                                Grid.Column="7"
                                                Content="Remove"
                                                Tag="{Binding}"
                                                Click="RemoveItemButton_Click"
                                                Padding="12,6"
                                                VerticalAlignment="Center" />

										</Grid>

									</Border>

								</DataTemplate>

							</ListView.ItemTemplate>

						</ListView>

					</StackPanel>

				</Border>


				<!-- =================================================
                     SUMMARY
                     ================================================= -->

				<Border
                    Style="{StaticResource SectionBorderStyle}">

					<Grid>

						<Grid.ColumnDefinitions>

							<ColumnDefinition
                                Width="*" />

							<ColumnDefinition
                                Width="Auto" />

						</Grid.ColumnDefinitions>


						<!-- LEFT SUMMARY -->

						<StackPanel>

							<TextBlock
                                Text="Summary"
                                Style="{StaticResource SectionTitleStyle}" />

							<TextBlock
                                x:Name="SubtotalTextBlock"
                                Text="Subtotal: Rs. 0.00"
                                Margin="0,3" />

							<TextBlock
                                x:Name="DiscountAmountTextBlock"
                                Text="Discount: Rs. 0.00"
                                Margin="0,3" />

							<TextBlock
                                x:Name="VATTextBlock"
                                Text="VAT: Rs. 0.00"
                                Margin="0,3" />

						</StackPanel>


						<!-- GRAND TOTAL -->

						<StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

							<TextBlock
                                Text="Grand Total"
                                FontSize="14"
                                Opacity="0.7"
                                HorizontalAlignment="Right" />

							<TextBlock
                                x:Name="GrandTotalTextBlock"
                                Text="Grand Total: Rs. 0.00"
                                FontSize="26"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right"
                                Margin="0,4,0,0" />

						</StackPanel>

					</Grid>

				</Border>


				<!-- =================================================
                     ACTIONS
                     ================================================= -->

				<Grid
                    Margin="0,4,0,20">

					<Grid.ColumnDefinitions>

						<ColumnDefinition
                            Width="*" />

						<ColumnDefinition
                            Width="Auto" />

					</Grid.ColumnDefinitions>


					<!-- CANCEL -->

					<Button
                        Grid.Column="0"
                        Content="Cancel"
                        Click="BackButton_Click"
                        Padding="24,10"
                        HorizontalAlignment="Left" />


					<!-- UPDATE -->

					<Button
                        Grid.Column="1"
                        Content="Update Sale"
                        Click="UpdateButton_Click"
                        Padding="30,11"
                        FontWeight="SemiBold" />

				</Grid>

			</StackPanel>

		</ScrollViewer>

	</Grid>

</Page>