<Page
    x:Class="NationalAgroTrading.WinUI.Views.Sales.BillDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

	<Grid Padding="24">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- =========================================================
             HEADER
             ========================================================= -->

		<Grid Grid.Row="0"
              Margin="0,0,0,20">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0"
                        Spacing="4">

				<TextBlock
                    x:Name="BillNumberTextBlock"
                    Text="Bill Details"
                    FontSize="28"
                    FontWeight="SemiBold"/>

				<TextBlock
                    x:Name="CompanyTextBlock"
                    Text="Company"
                    FontSize="16"
                    Opacity="0.75"/>

				<TextBlock
                    x:Name="DateTextBlock"
                    Text="Date"
                    FontSize="14"
                    Opacity="0.65"/>

			</StackPanel>

			<!-- Header actions -->

			<StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">

				<Button
                    Click="EditSaleButton_Click"
                    Padding="16,8">

					<StackPanel
                        Orientation="Horizontal"
                        Spacing="6">

						<FontIcon
                            Glyph="&#xE70F;"/>

						<TextBlock
                            Text="Edit Sale"/>

					</StackPanel>

				</Button>

				<Button
                    Click="DeleteSaleButton_Click"
                    Padding="16,8">

					<StackPanel
                        Orientation="Horizontal"
                        Spacing="6">

						<FontIcon
                            Glyph="&#xE74D;"/>

						<TextBlock
                            Text="Delete Sale"/>

					</StackPanel>

				</Button>

				<Button
                    Click="BackButton_Click"
                    Padding="16,8">

					<StackPanel
                        Orientation="Horizontal"
                        Spacing="6">

						<FontIcon
                            Glyph="&#xE72B;"/>

						<TextBlock
                            Text="Back"/>

					</StackPanel>

				</Button>

			</StackPanel>

		</Grid>


		<!-- =========================================================
             BILL INFORMATION
             ========================================================= -->

		<Border Grid.Row="1"
                Padding="16"
                Margin="0,0,0,16"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

			<Grid>

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<!-- Items -->

				<StackPanel Grid.Column="0"
                            Spacing="2">

					<TextBlock
                        Text="Items"
                        FontSize="12"
                        Opacity="0.65"/>

					<TextBlock
                        x:Name="ItemCountTextBlock"
                        Text="0"
                        FontSize="18"
                        FontWeight="SemiBold"/>

				</StackPanel>


				<!-- Subtotal -->

				<StackPanel Grid.Column="1"
                            Spacing="2">

					<TextBlock
                        Text="Subtotal"
                        FontSize="12"
                        Opacity="0.65"/>

					<TextBlock
                        x:Name="SubtotalTextBlock"
                        Text="Subtotal: Rs. 0.00"
                        FontSize="18"
                        FontWeight="SemiBold"/>

				</StackPanel>


				<!-- Discount -->

				<StackPanel Grid.Column="2"
                            Spacing="2">

					<TextBlock
                        Text="Discount"
                        FontSize="12"
                        Opacity="0.65"/>

					<TextBlock
                        x:Name="DiscountTextBlock"
                        Text="Discount: Rs. 0.00"
                        FontSize="18"
                        FontWeight="SemiBold"/>

				</StackPanel>


				<!-- VAT -->

				<StackPanel Grid.Column="3"
                            Spacing="2">

					<TextBlock
                        Text="VAT"
                        FontSize="12"
                        Opacity="0.65"/>

					<TextBlock
                        x:Name="VATTextBlock"
                        Text="VAT: Rs. 0.00"
                        FontSize="18"
                        FontWeight="SemiBold"/>

				</StackPanel>

			</Grid>

		</Border>


		<!-- =========================================================
             SALES ITEMS
             ========================================================= -->

		<Border Grid.Row="2"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

			<Grid>

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>


				<!-- Table header -->

				<Grid Grid.Row="0"
                      Padding="16,12"
                      Background="{ThemeResource SubtleFillColorSecondaryBrush}">

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="50"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="100"/>
						<ColumnDefinition Width="120"/>
						<ColumnDefinition Width="120"/>
						<ColumnDefinition Width="120"/>
						<ColumnDefinition Width="140"/>
					</Grid.ColumnDefinitions>

					<TextBlock
                        Grid.Column="0"
                        Text="#"
                        FontWeight="SemiBold"/>

					<TextBlock
                        Grid.Column="1"
                        Text="Product"
                        FontWeight="SemiBold"/>

					<TextBlock
                        Grid.Column="2"
                        Text="Quantity"
                        FontWeight="SemiBold"/>

					<TextBlock
                        Grid.Column="3"
                        Text="Price"
                        FontWeight="SemiBold"/>

					<TextBlock
                        Grid.Column="4"
                        Text="Subtotal"
                        FontWeight="SemiBold"/>

					<TextBlock
                        Grid.Column="5"
                        Text="Discount"
                        FontWeight="SemiBold"/>

					<TextBlock
                        Grid.Column="6"
                        Text="Total"
                        FontWeight="SemiBold"/>

				</Grid>


				<!-- Items -->

				<ListView
                    x:Name="SalesDetailsListView"
                    Grid.Row="1"
                    SelectionMode="None"
                    IsItemClickEnabled="False">

					<ListView.ItemTemplate>

						<DataTemplate>

							<Grid Padding="16,12">

								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="50"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="100"/>
									<ColumnDefinition Width="120"/>
									<ColumnDefinition Width="120"/>
									<ColumnDefinition Width="120"/>
									<ColumnDefinition Width="140"/>
								</Grid.ColumnDefinitions>

								<!-- Row number -->

								<TextBlock
                                    Grid.Column="0"
                                    Text="{Binding RowNumber}"
                                    VerticalAlignment="Center"/>


								<!-- Product -->

								<TextBlock
                                    Grid.Column="1"
                                    Text="{Binding ProductName}"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis"/>


								<!-- Quantity -->

								<TextBlock
                                    Grid.Column="2"
                                    Text="{Binding Quantity}"
                                    VerticalAlignment="Center"/>


								<!-- Price -->

								<TextBlock
                                    Grid.Column="3"
                                    Text="{Binding Price}"
                                    VerticalAlignment="Center"/>


								<!-- Subtotal -->

								<TextBlock
                                    Grid.Column="4"
                                    Text="{Binding Subtotal}"
                                    VerticalAlignment="Center"/>


								<!-- Discount -->

								<TextBlock
                                    Grid.Column="5"
                                    Text="{Binding Discount}"
                                    VerticalAlignment="Center"/>


								<!-- Total -->

								<TextBlock
                                    Grid.Column="6"
                                    Text="{Binding Total}"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"/>

							</Grid>

						</DataTemplate>

					</ListView.ItemTemplate>

				</ListView>

			</Grid>

		</Border>


		<!-- =========================================================
             FOOTER / GRAND TOTAL
             ========================================================= -->

		<Border Grid.Row="3"
                Margin="0,16,0,0"
                Padding="16"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

			<Grid>

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<TextBlock
                    Grid.Column="0"
                    Text="Grand Total"
                    FontSize="20"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

				<TextBlock
                    Grid.Column="1"
                    x:Name="GrandTotalTextBlock"
                    Text="Grand Total: Rs. 0.00"
                    FontSize="24"
                    FontWeight="Bold"
                    VerticalAlignment="Center"/>

			</Grid>

		</Border>

	</Grid>

</Page>